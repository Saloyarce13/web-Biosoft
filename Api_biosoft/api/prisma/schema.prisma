generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique @db.VarChar(50)
  description     String?          @db.VarChar(200)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  users           User[]

  @@map("roles")
}

model Permission {
  id              Int              @id @default(autoincrement())
  name            String           @unique @db.VarChar(100)
  description     String?          @db.VarChar(200)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id                 Int           @id @default(autoincrement())
  name               String        @db.VarChar(100)
  email              String        @unique @db.VarChar(150)
  passwordHash       String        @map("password") @db.VarChar(255)
  isActive           Boolean       @default(true)
  roleId             Int
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  emailVerified      Boolean       @default(false)
  passwordCodes      EmailCode[]
  createdByPurchases Purchase[]    @relation("PurchaseCreatedByUser")
  createdBySales     Sale[]        @relation("SaleCreatedByUser")
  transactions       Transaction[]
  role               Role          @relation(fields: [roleId], references: [id])

  @@map("users")
}

model EmailCode {
  id        Int       @id @default(autoincrement())
  type      CodeType
  email     String    @db.VarChar(150)
  codeHash  String    @db.VarChar(64)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  userId    Int?
  user      User?     @relation(fields: [userId], references: [id])

  @@index([email, type])
  @@index([expiresAt])
}

model Employee {
  id             Int        @id @default(autoincrement())
  fullName       String     @db.VarChar(120)
  email          String?    @unique @db.VarChar(150)
  phone          String?    @db.VarChar(30)
  documentType   String?    @db.VarChar(50)
  documentNumber String?    @db.VarChar(15)
  address        String?    @db.VarChar(250)
  birthDate      DateTime?
  position       String?    @db.VarChar(80)
  salary         Decimal?   @db.Decimal(12,2)
  hireDate       DateTime?
  password       String?    @db.VarChar(255)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  purchases Purchase[]
  sales     Sale[]
}

model Provider {
  id             Int               @id @default(autoincrement())
  name           String            @db.VarChar(150)
  businessName   String?           @db.VarChar(150)
  documentType   String?           @db.VarChar(10)
  documentNumber String?           @db.VarChar(20)
  contactPerson  String?           @db.VarChar(120)
  email          String?           @unique @db.VarChar(150)
  phone          String?           @db.VarChar(30)
  address        String?           @db.VarChar(250)
  website        String?           @db.VarChar(250)
  notes          String?           @db.VarChar(500)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  purchases      Purchase[]
  products       Product[]
  productProviders ProductProvider[]
}

model Client {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(150)
  email          String?  @unique @db.VarChar(150)
  phone          String?  @db.VarChar(30)
  address        String?  @db.VarChar(250)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  documentNumber String?  @db.VarChar(50)
  documentType   String?  @db.VarChar(10)
  sales          Sale[]
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  description String?   @db.VarChar(300)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("categories")
}

model Product {
  id            Int              @id @default(autoincrement())
  name          String           @db.VarChar(150)
  description   String?
  price         Decimal          @db.Decimal(10, 2)
  stock         Int              @default(0)
  minStock      Int              @default(0)
  sku           String?          @db.VarChar(50)
  image         String?          @db.VarChar(500)
  cost          Decimal?         @db.Decimal(10, 2)
  weight        Decimal?         @db.Decimal(8, 3)
  barcode       String?          @db.VarChar(100)
  isActive      Boolean          @default(true)
  categoryId    Int
  providerId    Int?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]
  category      Category         @relation(fields: [categoryId], references: [id])
  provider      Provider?        @relation(fields: [providerId], references: [id])
  providers     ProductProvider[]

  @@index([categoryId])
  @@index([providerId])
  @@map("products")
}

model ProductProvider {
  productId  Int
  providerId Int
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@id([productId, providerId])
  @@map("product_providers")
}

model Purchase {
  id              Int            @id @default(autoincrement())
  providerId      Int
  employeeId      Int?
  status          PurchaseStatus @default(REGISTERED)
  notes           String?        @db.VarChar(500)
  purchasedAt     DateTime       @default(now())
  pdfUrl          String?        @db.VarChar(500)
  totalPrice      Decimal        @default(0) @db.Decimal(12, 2)
  createdByUserId Int
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdByUser   User           @relation("PurchaseCreatedByUser", fields: [createdByUserId], references: [id])
  employee        Employee?      @relation(fields: [employeeId], references: [id])
  provider        Provider       @relation(fields: [providerId], references: [id])
  items           PurchaseItem[]
  transactions    Transaction[]

  @@index([providerId])
  @@index([status])
}

model PurchaseItem {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  productId  Int
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  lineTotal  Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id])
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@unique([purchaseId, productId])
  @@index([productId])
}

model Sale {
  id              Int           @id @default(autoincrement())
  clientId        Int
  employeeId      Int?
  status          SaleStatus    @default(REGISTERED)
  notes           String?       @db.VarChar(500)
  saleDate        DateTime      @default(now())
  pdfUrl          String?       @db.VarChar(500)
  totalPrice      Decimal       @default(0) @db.Decimal(12, 2)
  createdByUserId Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  client          Client        @relation(fields: [clientId], references: [id])
  createdByUser   User          @relation("SaleCreatedByUser", fields: [createdByUserId], references: [id])
  employee        Employee?     @relation(fields: [employeeId], references: [id])
  items           SaleItem[]
  transactions    Transaction[]

  @@index([clientId])
  @@index([status])
}

model SaleItem {
  id        Int      @id @default(autoincrement())
  saleId    Int
  productId Int
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)
  lineTotal Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@unique([saleId, productId])
  @@index([productId])
}

model Transaction {
  id         Int             @id @default(autoincrement())
  type       TransactionType
  amount     Decimal         @default(0) @db.Decimal(12, 2)
  userId     Int?
  purchaseId Int?
  saleId     Int?
  metadata   Json?
  createdAt  DateTime        @default(now())
  purchase   Purchase?       @relation(fields: [purchaseId], references: [id])
  sale       Sale?           @relation(fields: [saleId], references: [id])
  user       User?           @relation(fields: [userId], references: [id])
}

enum CodeType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum PurchaseStatus {
  REGISTERED
  COMPLETED
  CANCELLED
  ANNULED
}

enum SaleStatus {
  REGISTERED
  COMPLETED
  CANCELLED
  ANNULED
}

enum TransactionType {
  STOCK_IN
  STOCK_OUT
  PURCHASE_STATUS_CHANGED
  SALE_STATUS_CHANGED
  PASSWORD_CHANGED
}
